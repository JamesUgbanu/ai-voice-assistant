# Copy to .env (never commit). All secrets stay on the voice server.
# Required:
VOICE_RAG_API_URL=https://www.jamesugbanu.com/api/rag
VOICE_RAG_SERVICE_TOKEN=replace-me-with-portfolio-RAG_SERVICE_TOKEN
VOICE_HMAC_SECRET=replace-me-with-32-plus-random-bytes
# Models (locked after Phase 2 benchmarks; stock voice until authorized clip):
VOICE_STT_MODEL=base.en
# STT latency/accuracy knobs (P2I/P2J). Measured default: base.en + beam 1 is
# ~4x faster than small.en/beam5 with near-identical transcripts on the fixed
# suite; the initial_prompt restores proper-noun and technical vocabulary.
# VOICE_STT_BEAM_SIZE=1
# VOICE_STT_CPU_THREADS=0
# VOICE_STT_INITIAL_PROMPT=James Ugbanu, Chidera, Alimosho, Lagos, Nigeria, PostgreSQL, ...
# VOICE_STT_HOTWORDS=
# VOICE_STT_TEMPERATURE=0.0
# VOICE_STT_CONDITION_PREVIOUS=0
# Incremental transcription while the user is speaking (rolling-window
# partials; the final transcript is unchanged). Set VOICE_STT_STREAMING=0 to
# restore the previous behavior exactly (the rollback switch).
# VOICE_STT_STREAMING=1
# VOICE_STT_PARTIAL_INTERVAL_MS=900
# VOICE_STT_PARTIAL_MIN_AUDIO_MS=700
# VOICE_STT_PARTIAL_MAX_AUDIO_SECONDS=15
VOICE_TTS_LANGUAGE=english
# TTS segmentation (P2I): how long to wait for a natural boundary before
# speaking partial text. Lower = faster first audio, more chunk overhead.
# VOICE_TTS_MAX_WAIT_MS=1200
# Shorter wait before the FIRST spoken segment only (start speaking sooner);
# later segments still use VOICE_TTS_MAX_WAIT_MS. Set equal to MAX_WAIT to
# restore the previous behavior exactly.
# VOICE_TTS_FIRST_MAX_WAIT_MS=600
# VOICE_TTS_CLAUSE_TRIGGER_CHARS=80
# VOICE_TTS_MAX_CHARS=400
# VOICE_TTS_MIN_CHARS=12
# Voice mode: "preset" (built-in voice, always available) or "clone"
# (authorized reference recording). Clone requires the gated
# 'kyutai/pocket-tts' weights — accept the model terms and set HF_TOKEN.
# VOICE_TTS_MODE=preset
# VOICE_TTS_PRESET_VOICE=alba
# Path INSIDE the container to the prepared reference (mounted read-only by
# docker-compose.local.yml from ./voice-reference/processed). Never commit it.
# VOICE_TTS_VOICE_REF=/srv/voice/voice-reference/processed/voice-ref.wav
# Hugging Face token for gated weight access (clone only; never NEXT_PUBLIC_*).
# HF_TOKEN=
# Silero VAD source: upstream repo (network needed on first model load) or
# a vendored checkout via local:/path (recommended for reproducible deploys;
# pre-warm with one inference before opening traffic).
# VOICE_VAD_SOURCE=snakers4/silero-vad
# VOICE_VAD_SOURCE=local:/srv/voice/vendor/silero-vad
# Quotas and budgets (defaults shown):
VOICE_MAX_CALL_SECONDS=300
VOICE_DAILY_ALLOWANCE_SECONDS=600
VOICE_SESSION_ATTEMPTS=3
VOICE_SESSION_ATTEMPT_WINDOW_SECONDS=600
VOICE_STALE_SESSION_SECONDS=600
VOICE_MAX_AUDIO_FRAME_BYTES=192000
VOICE_MAX_TURN_AUDIO_SECONDS=60
VOICE_MAX_MESSAGE_BYTES=262144
VOICE_RAG_TIMEOUT_SECONDS=25
# Composer dictation endpoint (same loaded Whisper model; byte cap bounds
# per-request memory). Uncomment to override defaults.
# VOICE_TRANSCRIBE_MAX_SECONDS=30
# VOICE_TRANSCRIBE_PER_MINUTE=20
# VOICE_TRANSCRIBE_TICKET_PER_MINUTE=30
# VOICE_TRANSCRIBE_TICKET_TTL_SECONDS=300
# Operations:
VOICE_DB_PATH=/srv/voice/data/voice.sqlite3
VOICE_PUBLIC_BASE_URL=https://voice.jamesugbanu.com
VOICE_ALLOWED_ORIGINS=https://www.jamesugbanu.com
VOICE_IP_SALT=replace-me-with-random-salt
# Set to 1 only for offline test runs without model packages:
# VOICE_USE_STUBS=0
