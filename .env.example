# Voice service configuration. Copy to .env and replace every placeholder.
# .env is Git-ignored; never commit real secrets.
#
# Required (the service refuses to start without them):
#   VOICE_HMAC_SECRET
#   one conversational backend:
#     - VOICE_RESPONDER=portfolio  -> VOICE_RAG_API_URL + VOICE_RAG_SERVICE_TOKEN
#     - VOICE_RESPONDER=http       -> VOICE_RESPONDER_URL

# ---------------------------------------------------------------------------
# Conversational backend
# ---------------------------------------------------------------------------
# "portfolio" (reference adapter, default) or "http" (your own backend).
VOICE_RESPONDER=portfolio

# Required when VOICE_RESPONDER=portfolio. The reference deployment uses the
# portfolio RAG API; point this at your own compatible SSE endpoint otherwise.
# Example: https://your-app.example/api/rag
VOICE_RAG_API_URL=https://your-app.example/api/rag
VOICE_RAG_SERVICE_TOKEN=replace-with-your-backend-bearer-token
# Per-operation timeout for the portfolio RAG stream (seconds).
# VOICE_RAG_TIMEOUT_SECONDS=25

# Required when VOICE_RESPONDER=http. Contract: POST JSON
# {question, history, sessionId}; reply with SSE `event: token`
# `data: {"text": ...}` frames and a final `event: done`.
# See INTEGRATION.md and examples/echo_backend.py.
# VOICE_RESPONDER_URL=http://127.0.0.1:9000/respond
# VOICE_RESPONDER_TOKEN=
# VOICE_RESPONDER_TIMEOUT_SECONDS=25

# ---------------------------------------------------------------------------
# Security (required)
# ---------------------------------------------------------------------------
# Signs short-lived session/dictation tickets. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VOICE_HMAC_SECRET=replace-with-32-plus-random-bytes
# Salt for hashed IPs in attempt buckets. Set for stable buckets across
# restarts; leave unset for an ephemeral per-process salt.
VOICE_IP_SALT=replace-with-a-random-salt

# ---------------------------------------------------------------------------
# HTTP / browser integration
# ---------------------------------------------------------------------------
# Origin used to build the session's ws_url. Use https:// in production.
VOICE_PUBLIC_BASE_URL=https://voice.example.com
# Comma-separated exact browser origins. No wildcards. The reference
# deployment uses https://www.jamesugbanu.com.
VOICE_ALLOWED_ORIGINS=https://your-frontend.example
# SQLite path for sessions/quotas (single worker; no external database).
# Docker Compose sets /srv/voice/data/voice.sqlite3 for the container.
VOICE_DB_PATH=data/voice.sqlite3

# ---------------------------------------------------------------------------
# Speech models
# ---------------------------------------------------------------------------
VOICE_STT_MODEL=base.en
# VOICE_STT_BEAM_SIZE=1
# VOICE_STT_CPU_THREADS=0
# Optional domain vocabulary improves proper nouns and product names.
# Do not use personal data you are not authorized to process.
# VOICE_STT_INITIAL_PROMPT=YourProduct, PostgreSQL, TypeScript, Terraform
# VOICE_STT_HOTWORDS=
# VOICE_STT_TEMPERATURE=0.0
# VOICE_STT_CONDITION_PREVIOUS=0
# Incremental transcription while speaking (set 0 to disable).
# VOICE_STT_STREAMING=1
# VOICE_STT_PARTIAL_INTERVAL_MS=900
# VOICE_STT_PARTIAL_MIN_AUDIO_MS=700
# VOICE_STT_PARTIAL_MAX_AUDIO_SECONDS=15
# Silero VAD source (torch.hub). Use local:/path to vendor it.
# VOICE_VAD_SOURCE=snakers4/silero-vad

# TTS: "preset" (built-in voice, always available) or "clone" (authorized
# reference). Clone requires the gated kyutai/pocket-tts weights and HF_TOKEN.
VOICE_TTS_MODE=preset
VOICE_TTS_LANGUAGE=english
# VOICE_TTS_PRESET_VOICE=alba
# Optional: pinned model/tokenizer manifest (default deploy/model-manifest.json).
# VOICE_MODEL_MANIFEST=/srv/voice/deploy/model-manifest.json
# Required only for VOICE_TTS_MODE=clone; path inside the runtime.
# VOICE_TTS_VOICE_REF=/srv/voice/voice-reference/processed/voice-ref.wav
# HF_TOKEN=
# Segmentation: how long to wait for a natural boundary before speaking.
# VOICE_TTS_MAX_WAIT_MS=1200
# VOICE_TTS_FIRST_MAX_WAIT_MS=600
# VOICE_TTS_CLAUSE_TRIGGER_CHARS=80
# VOICE_TTS_MAX_CHARS=400
# VOICE_TTS_MIN_CHARS=12

# ---------------------------------------------------------------------------
# Limits and abuse controls
# ---------------------------------------------------------------------------
# VOICE_MAX_CALL_SECONDS=300
# VOICE_DAILY_ALLOWANCE_SECONDS=600
# VOICE_SESSION_ATTEMPTS=3
# VOICE_SESSION_ATTEMPT_WINDOW_SECONDS=600
# VOICE_STALE_SESSION_SECONDS=600
# VOICE_MAX_AUDIO_FRAME_BYTES=192000
# VOICE_MAX_TURN_AUDIO_SECONDS=60
# VOICE_MAX_MESSAGE_BYTES=262144

# ---------------------------------------------------------------------------
# Optional endpoints
# ---------------------------------------------------------------------------
# Composer dictation and "listen to response" reuse the loaded models.
# VOICE_TRANSCRIBE_MAX_SECONDS=30
# VOICE_TRANSCRIBE_PER_MINUTE=20
# VOICE_TRANSCRIBE_TICKET_PER_MINUTE=30
# VOICE_TRANSCRIBE_TICKET_TTL_SECONDS=300
# VOICE_TTS_LISTEN_MAX_CHARS=2000
# VOICE_TTS_PER_MINUTE=12
# VOICE_TTS_TICKET_PER_MINUTE=20
# VOICE_TTS_TICKET_TTL_SECONDS=300

# Optional automatic call ending on a clear goodbye. Leave the closing empty
# to disable the spoken goodbye; the call still ends after playback.
# VOICE_END_CALL_CONFIDENCE=0.8
# VOICE_END_CALL_CLOSING=Thanks for your time. Goodbye!
# VOICE_PLAYBACK_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Portfolio-only voice booking
# ---------------------------------------------------------------------------
# Booking-only is the reference behavior: greetings and scheduling are handled
# locally, unrelated questions get a booking prompt, and the portfolio RAG is
# not asked for contact/factual answers. Only the portfolio adapter uses this.
# Set 0 only if you intentionally want the portfolio Q&A fallback.
# VOICE_BOOKING_ONLY=1
# The booking URL defaults to the origin of VOICE_RAG_API_URL + /api/booking
# when the RAG URL ends in /api/rag. Availability derives as
# <VOICE_BOOKING_API_URL>/availability unless explicitly set.
# VOICE_BOOKING_API_URL=
# VOICE_BOOKING_AVAILABILITY_URL=
# VOICE_BOOKING_TIMEZONE=Africa/Lagos
# VOICE_BOOKING_DURATION_MINUTES=30
# VOICE_BOOKING_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# 1 = deterministic stub STT/TTS/VAD (no model downloads). Never in production.
# VOICE_USE_STUBS=0

# ---------------------------------------------------------------------------
# Optional widget/session tokens
# ---------------------------------------------------------------------------
# The widget can present a short-lived, project-scoped token issued by the
# integrating backend (see the portfolio's /api/widget/token). "anonymous"
# keeps the existing per-IP/visitor flow; "required" accepts only valid tokens.
# VOICE_WIDGET_AUTH_MODE=anonymous
# VOICE_WIDGET_TOKEN_SECRET=replace-with-the-same-32-plus-byte-secret
# VOICE_WIDGET_ALLOWED_PROJECTS=portfolio
