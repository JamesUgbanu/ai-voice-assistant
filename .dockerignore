# Keep private recordings and local state out of the image build context.
# The Dockerfile COPYs pyproject.toml, app/, and optionally one authorized
# reference at deploy/reference/voice-ref.wav. Everything else with private
# audio is excluded; the reference is re-included explicitly below.
.env
.git
.github
.gitignore
.venv
venv
__pycache__/
*.pyc
*.egg-info/
build/
dist/
data/
models/
docs/
examples/
infra/
scripts/
tests/
voice-reference/
voices/
whisper-captures/
*.wav
*.mp3
# The reference directory must exist in the build context even on a clean
# checkout (it contains .gitkeep). Only the authorized WAV is re-included.
!deploy/reference/.gitkeep
!deploy/reference/voice-ref.wav
